{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "02634d82c7653e19b80f3a663e347cd3046b7b35",
  "packages": {
    ".": {
      "release-type": "simple",
      "release-as": "0.1.0",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "skip-changelog": true,
      "pull-request-title-pattern": "chore(release): v${version}",
      "exclude-paths": ["demo", ".github"],
      "extra-files": [
        { "type": "json", "path": "ts/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "ts/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "ts/package-lock.json", "jsonpath": "$.packages[\"\"].version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "build", "section": "Build System" },
        { "type": "revert", "section": "Reverts" }
      ]
    }
  }
}
