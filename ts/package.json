{
  "name": "@usegoodkey/pqc-ratchet",
  "version": "0.1.0",
  "description": "Post-quantum Double Ratchet + X3DH in TypeScript (ML-KEM-768, ML-DSA-65). Wire-compatible with the Go module github.com/usegoodkey/pqc-ratchet/go.",
  "type": "module",
  "sideEffects": false,
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "keywords": [
    "post-quantum",
    "double-ratchet",
    "x3dh",
    "ml-kem",
    "ml-dsa",
    "signal",
    "e2ee"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usegoodkey/pqc-ratchet",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/usegoodkey/pqc-ratchet/issues"
  },
  "homepage": "https://github.com/usegoodkey/pqc-ratchet/tree/main/ts#readme",
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
